# ==============================================================================
# Configurações de Ambiente - Empório da Música (AI Agent)
# ==============================================================================

# Provedor do Modelo de Linguagem (LLM): 'google' | 'openai'
LLM_PROVIDER=google

# Chaves de API (configure pelo menos uma dependendo do LLM_PROVIDER escolhido)
GOOGLE_API_KEY=sua_chave_gemini_aqui
OPENAI_API_KEY=sua_chave_openai_aqui

# Modelos recomendados para bom equilíbrio entre latência, custo e raciocínio técnico
# Google: gemini-2.5-flash, gemini-1.5-flash, gemini-1.5-pro
# OpenAI: gpt-4o-mini, gpt-4o
LLM_MODEL=gemini-2.5-flash

# Modelo de Embeddings para busca nas políticas (RAG)
# Google: text-embedding-004
# HuggingFace local: sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=text-embedding-004

# Diretório base dos arquivos de dados operacionais
DATA_DIR=data

# Nível de logging (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
